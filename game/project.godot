[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=true
textures/default_filters/anisotropic_filtering_level=0

; O renderizador de compatibilidade descarta em SILENCIO as luzes que passam do
; limite por objeto, e como o interior e fundido numa malha por material, todas
; as luzes do comodo disputam o mesmo teto. Quem some nao e escolhido por quem
; escreveu a cena: e o comodo inteiro que nasce escuro, sem uma linha no console.
;
; O censo do mercado, que e o comodo mais carregado do jogo:
;
;   13  Lampada        4 calhas de corredor, a do balcao, 2 da camara fria,
;                      a vitrine quente, garagem, corredor, visor da maquina
;                      de refri, banheiro e copa
;    1  OmniLight      a luz vermelha do leitor de codigo do balcao
;    1  OmniLight      o ponto de save (telefone da loja)
;   --
;   15
;
; Com o teto em 16 sobrava UMA vaga, e a proxima peca com luz que alguem
; acrescentasse apagaria um comodo sem avisar. Vinte e quatro da folga para
; nove pecas novas. O custo e loop de luz por fragmento a 480x270, que nao se
; mede; o custo de perder a luz da copa e uma tarde procurando o que houve.
limits/opengl/max_lights_per_object=24
