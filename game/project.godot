; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Nevoa e Dither"
config/version="0.1.0"
run/main_scene="res://scenes/test/cidade.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Medidor="*res://src/systems/medidor_quadro.gd"
Settings="*res://src/systems/settings.gd"
EstiloVisual="*res://src/render/estilo_visual.gd"
DiretorSombra="*res://src/render/diretor_sombra.gd"
Inventario="*res://src/systems/inventario.gd"
AudioDirector="*res://src/systems/audio_director.gd"
WorldState="*res://src/world/world_state.gd"
ChunkManager="*res://src/world/chunk_manager.gd"
Interiores="*res://src/systems/interiores.gd"
Clima="*res://src/world/clima.gd"
Dialogo="*res://src/ui/dialogo.gd"
RegistroCivil="*res://src/systems/registro_civil.gd"
Conversa="*res://src/ui/conversa.gd"
Documento="*res://src/ui/documento.gd"
Celular="*res://src/ui/celular.gd"
Gps="*res://src/ui/gps.gd"
Terminal="*res://src/ui/terminal.gd"
Cinema="*res://src/ui/cinematica.gd"
Missoes="*res://src/systems/missoes.gd"
Multidao="*res://src/world/multidao.gd"
Transito="*res://src/world/transito.gd"
BlitzManager="*res://src/world/blitz_manager.gd"
RadioCarro="*res://src/ui/radio_carro.gd"
SaveGame="*res://src/systems/save_game.gd"
CaptureTool="*res://src/systems/capture_tool.gd"
Sessao="*res://src/net/sessao.gd"
Qualidade="*res://src/systems/qualidade_grafica.gd"
Lente="*res://src/render/lente.gd"
Ceu="*res://src/world/diretor_ceu.gd"
ChuvaFora="*res://src/world/diretor_chuva_fora.gd"
Foto="*res://src/systems/modo_foto.gd"
Eco="*res://src/systems/eco_ambiente.gd"
UIManager="*res://src/ui/ui_manager.gd"

[debug]

gdscript/warnings/untyped_declaration=1
gdscript/warnings/unsafe_property_access=1

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"

[importer_defaults]

texture={
"compress/channel_pack": 0,
"compress/high_quality": false,
"compress/mode": 0,
"compress/normal_map": 0,
"detect_3d/compress_to": 0,
"mipmaps/generate": false,
"process/fix_alpha_border": false,
"process/premult_alpha": false,
"process/size_limit": 0
}

