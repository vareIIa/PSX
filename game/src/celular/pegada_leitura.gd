## A mao na troca em `u` (0 a 1), terminando na pegada `leitura`.
static func troca(u: float, leitura: Dictionary) -> Dictionary:
	var n := TROCA.size()
	var f := clampf(u, 0.0, 1.0) * float(n)
	var i := mini(int(f), n - 1)
	var ate: Dictionary = leitura if i + 1 >= n else TROCA[i + 1]
	return BracoVivo._misturar(TROCA[i], ate, f - float(i))
